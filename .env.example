# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/studyconnect?retryWrites=true&w=majority

# JWT secret — use a long random string (32+ chars)
JWT_SECRET=change_this_to_a_long_random_secret_string

# Server port (optional, defaults to 3000)
PORT=3000
